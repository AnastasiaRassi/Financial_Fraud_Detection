{
  "logging": {
    "enabled": true,
    "level": "INFO",
    "format": "[%(asctime)s] %(levelname)s - %(name)s - %(message)s",
    "handlers": ["console", "file"],
    "file_path": "logs/project.log",
    "requirements": [
      "All modules (preprocessor, validator, transformer, trainer, etc.) must log key actions, warnings, and errors.",
      "Log input shapes, output shapes, and major transformation steps.",
      "Log hyperparameters, seeds, and configuration at the start of each experiment.",
      "Log exceptions with full stack traces without silencing them.",
      "Log start and end of each major function for traceability."
    ],
    "module_specific": {
      "preprocessor": [
        "Log null checks and imputation actions.",
        "Log StandardScaler fit/transform actions."
      ],
      "validator": [
        "Log schema validations and shape consistency checks.",
        "Log any failed validation deterministically."
      ],
      "transformer": [
        "Log fit and transform operations, including paths of saved scaler objects."
      ],
      "trainer": [
        "Log start/end of each epoch.",
        "Log batch metrics, optimizer steps, and scheduler updates."
      ],
      "utils": [
        "Log critical utilities like file loading, seed setting, and config parsing."
      ]
    },
    "implementation_notes": [
      "Use Python's logging module only.",
      "Ensure logs respect the global logging level from config.",
      "Do not replace MLflow metrics/artifacts logging; logging is complementary.",
      "All logs should be deterministic and reproducible across seeds."
    ]
  }
}
